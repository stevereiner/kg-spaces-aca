server {
    listen 8080;
    server_name localhost;

    # File upload on the OTHER SOURCES tab goes through /api/upload; nginx's 1 MB default
    # would reject most documents before they reach the backend.
    client_max_body_size 200m;

    # Alfresco and the backend are looked up per request (variables below), so a backend container recreated with a
    # new address is found again, and this starts even when one of them is down; NGINX_LOCAL_RESOLVERS comes from the
    # nginx image's 15-local-resolvers.envsh
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;

    # ACA's static files
    location / {
        root   /usr/share/nginx/html;
        index  index.html;
        try_files $uri $uri/ /index.html;
    }

    # Alfresco. ADF's ecmHost stays at its same-origin default, so every repository call
    # from the browser arrives here.
    location /alfresco/ {
        set $alfresco_upstream ${ALFRESCO_URL};
        proxy_pass $alfresco_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Flexible GraphRAG backend. AI query and chat wait on an LLM, and a synchronous call can
    # run for minutes, so the read timeout is generous.
    location /api/ {
        set $backend_upstream ${FLEXIBLE_GRAPHRAG_URL};
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # rewritten at startup by 40-kg-spaces-config.sh, so never cache it
    location = /app.config.json {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-cache";
    }
}
